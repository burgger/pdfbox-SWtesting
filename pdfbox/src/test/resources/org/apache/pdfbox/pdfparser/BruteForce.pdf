%PDF-1.4
% ASCII-only PDF to trigger BruteForceParser bfSearchForXRefStreams()

1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj

2 0 obj
<< /Type /Pages /Count 1 /Kids [3 0 R] >>
endobj

3 0 obj
<< /Type /Page
   /Parent 2 0 R
   /MediaBox [0 0 200 200]
   /Contents 4 0 R
   /Resources << /Font << /F1 5 0 R >> >>
>>
endobj

4 0 obj
<< /Length 35 >>
stream
BT /F1 12 Tf 10 180 Td (Hi) Tj ET
endstream
endobj

5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj

% This object exists mainly so the file contains "/XRef" close to " obj".
% BruteForceParser searches for "/XRef" and scans backward to find " obj" with digits.
6 0 obj
<< /Type /XRef /Length 0 >>
stream
endstream
endobj

trailer
<< /Size 7 /Root 1 0 R >>
startxref
123456
%%EOF
